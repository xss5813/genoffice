FROM node:22-alpine AS builder

WORKDIR /build

RUN apk add --no-cache python3 make g++ git curl bash file \
 && npm install -g yarn --ignore-scripts

ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    ELECTRON_MIRROR=https://registry.npmmirror.com/mirrors/electron/ \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    SKIP_ELECTRON_BUILD=1 \
    NODE_OPTIONS=--max_old_space_size=2048

COPY package.json ./
COPY yarn.lock* ./
COPY package-lock.json* ./
COPY packages/ ./packages/

RUN if [ -f yarn.lock ]; then \
      yarn install --frozen-lockfile --ignore-scripts --ignore-engines --network-timeout 600000 || \
      yarn install --ignore-scripts --ignore-engines --network-timeout 600000; \
    elif [ -f package-lock.json ]; then \
      npm ci --ignore-scripts || npm install --ignore-scripts; \
    else \
      npm install --ignore-scripts; \
    fi

COPY . .

RUN if [ -f yarn.lock ]; then \
      yarn build || npm run build; \
    else \
      npm run build; \
    fi || true

RUN if [ -f yarn.lock ]; then \
      yarn install --production --ignore-scripts --ignore-engines || true; \
    else \
      npm prune --production --omit=dev; \
    fi


FROM alpine:3.19

RUN apk add --no-cache \
    nodejs \
    chromium \
    nss \
    freetype \
    harfbuzz \
    font-noto-cjk \
    ttf-freefont \
    xvfb-run \
    dumb-init \
    ca-certificates \
    && rm -rf /var/cache/apk/*

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && mkdir -p /home/appuser/Documents \
    && chown -R appuser:appgroup /home/appuser

COPY --from=builder /build/node_modules /build/node_modules
COPY --from=builder /build/packages /build/packages
COPY --from=builder /build/package.json /build/package.json

ENV NODE_PATH=/build/node_modules \
    DISPLAY=:99 \
    CHROME_BIN=/usr/bin/chromium \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

USER appuser
WORKDIR /home/appuser

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "--version"]
