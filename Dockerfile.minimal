# Dockerfile.minimal
FROM node:20-alpine AS builder

WORKDIR /build

RUN apk add --no-cache python3 make g++ git

COPY package.json ./
COPY yarn.lock* ./
COPY package-lock.json* ./
COPY packages/ ./packages/

RUN if [ -f yarn.lock ]; then \
      corepack enable 2>/dev/null || true; \
      yarn install --frozen-lockfile || yarn install; \
    elif [ -f package-lock.json ]; then \
      npm ci || npm install; \
    else \
      npm install; \
    fi

COPY . .

RUN if [ -f yarn.lock ]; then \
      yarn build; \
    else \
      npm run build; \
    fi || true

RUN if [ -f yarn.lock ]; then \
      yarn install --production --ignore-scripts || yarn install --production; \
    else \
      npm prune --production --omit=dev; \
    fi


FROM alpine:3.19

RUN apk add --no-cache \
    nodejs \
    chromium \
    chromium-swiftshader \
    nss \
    freetype \
    harfbuzz \
    font-noto-cjk \
    ttf-freefont \
    xvfb-run \
    dumb-init \
    ca-certificates \
    && ln -s /usr/bin/chromium-browser /usr/bin/chromium 2>/dev/null || true \
    && rm -rf /var/cache/apk/*

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && mkdir -p /home/appuser/Documents \
    && chown -R appuser:appgroup /home/appuser

COPY --from=builder /build/node_modules /build/node_modules
COPY --from=builder /build/packages /build/packages
COPY --from=builder /build/package.json /build/package.json

ENV NODE_PATH=/build/node_modules \
    DISPLAY=:99 \
    CHROME_BIN=/usr/bin/chromium \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

USER appuser
WORKDIR /home/appuser

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["node", "--version"]
